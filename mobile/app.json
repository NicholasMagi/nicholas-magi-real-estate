{
  "expo": {
    "name": "NMRE Mobile",
    "slug": "nmre-mobile",
    "version": "0.1.0",
    "scheme": "nmre-mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "it.nicholasmagi.nmremobile",
      "supportsTablet": true
    },
    "android": {
      "package": "it.nicholasmagi.nmremobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
