{
  "expo": {
    "name": "NMRE Mobile",
    "slug": "nmre-mobile",
    "version": "0.1.0",
    "scheme": "nmre-mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "it.nicholasmagi.nmremobile",
      "supportsTablet": true
    },
    "android": {
      "package": "it.nicholasmagi.nmremobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Consenti a NMRE di leggere i contatti per importarli nella Rubrica del gestionale e associare gli annunci ai contatti corretti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
